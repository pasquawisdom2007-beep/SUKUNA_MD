# ===== Bot owner =====
BOT_NAME=SUKUNA MD
OWNER_NUMBER=

# ===== Optional: non-interactive pairing =====
# If your panel has no interactive console, set the number here.
# The bot will print the pairing code once on boot, then run normally.
# PAIR_NUMBER=2349127857212
# Pasqua Baileys custom pairing code; must be exactly 8 characters.
# PAIRING_CODE=PASQUAMD
# SESSION_ID=raw-base64-creds-json-from-pair-site

# ===== Optional API keys =====
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Free default MusicGen provider; override only if using another compatible Space.
# MUSICGEN_HF_SPACE_URL=https://facebook-musicgen.hf.space
# MUSICGEN_HF_API_PREFIX=/gradio_api
# MUSICGEN_HF_API_NAME=predict_batched
# Optional fallback if the free public Space is unavailable.
# REPLICATE_API_TOKEN=
# Weather and app-store settings
# WEATHER_API_KEY=
# PLAYSTORE_LANG=en
# PLAYSTORE_COUNTRY=us
# APK downloads resolve through the official F-Droid repository only by default.
# Optional comma-separated HTTPS hostnames for approved F-Droid mirrors.
# FDROID_ALLOWED_MIRRORS=

# ===== Required for .editimage =====
# Free key from https://api.imgbb.com/ (sign up, then grab key from
# https://api.imgbb.com/ "Add API key" page). Used to host the source
# image at a public URL so the NanoBanana API can fetch it.
IMGBB_API_KEY=

# ===== Required for .tiksearch =====
# Free key (100 req/day) from https://tiktokapi.store/registration/new
TIKTOKAPI_STORE_KEY=
